<div class="thorunn-credits-dialog">
  <div class="thorunn-hero">
    <div class="thorunn-avatar-wrap">
      <i class="fas fa-hat-wizard fa-3x"></i>
    </div>
    <div class="thorunn-title-block">
      <h2>{{localize "METAMOEDAS.Credits.Author"}}</h2>
      <span class="thorunn-subtitle">{{localize "METAMOEDAS.Credits.Role"}}</span>
    </div>
  </div>

  <div class="thorunn-bio-text">
    <p>{{localize "METAMOEDAS.Credits.Bio1"}}</p>
    <p>{{localize "METAMOEDAS.Credits.Bio2"}}</p>
    <p>{{localize "METAMOEDAS.Credits.Bio3"}}</p>
    <blockquote class="golden-rule-quote">
      <i class="fas fa-quote-left"></i>
      <strong>{{localize "METAMOEDAS.Credits.GoldenRuleLabel"}}:</strong>
      {{localize "METAMOEDAS.Credits.GoldenRule"}}
      <i class="fas fa-quote-right"></i>
    </blockquote>
  </div>

  <div class="thorunn-links-grid">
    <a href="https://www.instagram.com/thorunnx.gm/" target="_blank" rel="noopener noreferrer" class="credit-link-card instagram-card">
      <i class="fab fa-instagram fa-2x"></i>
      <div class="link-info">
        <span class="link-label">{{localize "METAMOEDAS.Credits.InstagramLabel"}}</span>
        <span class="link-handle">@thorunnx.gm</span>
      </div>
      <i class="fas fa-external-link-alt"></i>
    </a>

    <a href="https://drive.google.com/file/d/1gIXVmpg3vQv0zKMFqaJItPWTKe-qjBLV/view" target="_blank" rel="noopener noreferrer" class="credit-link-card pdf-card">
      <i class="fas fa-file-pdf fa-2x"></i>
      <div class="link-info">
        <span class="link-label">{{localize "METAMOEDAS.Credits.DrivePdf"}}</span>
        <span class="link-desc">{{localize "METAMOEDAS.Credits.DownloadPdfDesc"}}</span>
      </div>
      <i class="fas fa-external-link-alt"></i>
    </a>

    <a href="https://rpg.charlescorrea.com.br/dicas/transforme-o-metagame-da-sua-mesa-em-caos-narrativo-com-o-guia-das-metamoedas-by-thorunn/" target="_blank" rel="noopener noreferrer" class="credit-link-card blog-card">
      <i class="fas fa-newspaper fa-2x"></i>
      <div class="link-info">
        <span class="link-label">{{localize "METAMOEDAS.Credits.BlogArticle"}}</span>
        <span class="link-desc">rpg.charlescorrea.com.br</span>
      </div>
      <i class="fas fa-external-link-alt"></i>
    </a>

    <a href="https://github.com/CharlesCorreaDev/" target="_blank" rel="noopener noreferrer" class="credit-link-card github-card">
      <i class="fab fa-github fa-2x"></i>
      <div class="link-info">
        <span class="link-label">GitHub</span>
        <span class="link-handle">@CharlesCorreaDev</span>
      </div>
      <i class="fas fa-external-link-alt"></i>
    </a>

    <a href="https://instagram.com/MestreCharlesCorrea" target="_blank" rel="noopener noreferrer" class="credit-link-card instagram-card">
      <i class="fab fa-instagram fa-2x"></i>
      <div class="link-info">
        <span class="link-label">Instagram do Desenvolvedor</span>
        <span class="link-handle">@MestreCharlesCorrea</span>
      </div>
      <i class="fas fa-external-link-alt"></i>
    </a>
  </div>
</div>
