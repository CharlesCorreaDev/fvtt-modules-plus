<div class="metamoedas-chat-card">
  <div class="card-header">
    <div class="header-icon"><i class="fa-solid fa-skull"></i></div>
    <div class="header-title">
      <h3>{{title}}</h3>
      <span class="card-tier-badge"><i class="fa-solid fa-coins"></i> {{cost}} {{localize "METAMOEDAS.App.Coins"}} • {{tier}}</span>
    </div>
  </div>

  <div class="card-target">
    <span class="target-label"><i class="fa-solid fa-crosshairs"></i> {{localize "METAMOEDAS.Chat.Victim"}}:</span>
    <strong class="target-name">{{targetName}}</strong>
  </div>

  <div class="card-effect">
    <p>{{effect}}</p>
  </div>

  <div class="card-footer">
    <span class="attribution">
      <i class="fa-solid fa-book-skull"></i> <em>{{localize "METAMOEDAS.Chat.Attribution"}}</em>
    </span>
  </div>
</div>
