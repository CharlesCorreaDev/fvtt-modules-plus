<div
  class="swag-card {{#if isDamage}}border-swag-damage{{else if isCriticalFailure}}border-swag-critical{{else if isCriticalSuccess}}border-swag-damage{{else if isRaise}}border-swag-raise{{else if isArcane}}border-swag-arcane{{else if isEdge}}border-swag-edge{{else if isHindrance}}border-swag-hindrance{{else if isLore}}border-swag-lore{{else if isSuccess}}border-swag-success{{else if isItem}}border-swag-item{{else}}border-swag-critical{{/if}}"
  id="{{cardId}}"
  data-tn="{{targetNumber}}"
  data-is-damage="{{#if isDamage}}true{{else}}false{{/if}}"
  data-crit-fail="{{#if isCriticalFailure}}true{{else}}false{{/if}}"
>
  <!-- 1. TOPO DO CARD: Avatar / Ícone, Título, Subtítulo e Horário -->
  <div class="swag-card-header p-3 pb-2 border-bottom border-secondary border-opacity-10">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
        {{#if iconClass}}
        <div class="swag-icon-box rounded {{iconBgClass}} border d-flex align-items-center justify-content-center">
          <i class="{{iconClass}}"></i>
        </div>
        {{else if actorImg}}
        <img src="{{actorImg}}" class="actor-avatar" alt="{{actorName}}" />
        {{else}}
        <img src="{{itemImg}}" class="actor-avatar" alt="{{actorName}}" />
        {{/if}}

        <div class="min-w-0 flex-grow-1">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <h6 class="swag-card-title mb-0 fw-bold text-light font-heading">{{{title}}}</h6>
            {{#if isBennyReroll}}
            <span class="badge swag-benny-reroll-badge">
              <i class="fa-solid fa-coins me-1"></i> BENE GASTO (RE-ROLAGEM)
            </span>
            {{else if isReroll}}
            <span class="badge swag-reroll-badge">
              <i class="fa-solid fa-rotate-right me-1"></i> RE-ROLAGEM
            </span>
            {{/if}}
            {{#if topBadge}}
            <span class="badge {{topBadge.class}}" style="font-size: 0.65rem;">{{topBadge.text}}</span>
            {{/if}}
          </div>
          {{#if subtitle}}
          <small class="swag-card-subtitle text-secondary d-block">{{{subtitle}}}</small>
          {{/if}}
        </div>
      </div>

      <!-- Horário limpo no Canto Direito -->
      <div class="text-end flex-shrink-0">
        {{#if timestamp}}
        <div class="text-muted" style="font-size: 0.68rem; margin-top: 2px;">{{timestamp}}</div>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- 2. CORPO DO CARD -->
  <div class="swag-card-body p-3 pt-2">
    <!-- Metadados de SWADE (1 item por linha ocupando toda a largura com tooltip explicativo) -->
    {{#if metaGrid}}
    <div class="swag-meta-grid mb-2 p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-10 small">
      {{#each metaGrid}}
      <div class="swag-meta-cell" {{#if this.tooltip}}data-tooltip="{{this.tooltip}}" title="{{this.tooltip}}"{{/if}}>
        <span class="stat-label">{{this.label}}</span>
        <span class="stat-value {{this.class}}">{{{this.value}}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Dados Rolados (Dice Breakdown + Wild Die limpos) -->
    {{#if diceBreakdown}}
    <div class="bg-black bg-opacity-30 p-2 rounded mb-2 border border-secondary border-opacity-10">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          {{#each diceBreakdown}}
          <span class="dice-pill {{#if this.isWild}}wild-die{{else if this.isArcane}}arcane-die{{else}}trait-die{{/if}} {{#if this.isAce}}ace{{/if}}" title="{{this.tooltip}}">
            <i class="{{#if this.icon}}{{this.icon}}{{else if this.isWild}}fa-solid fa-dice-d6{{else}}fa-solid fa-dice-d{{this.faces}}{{/if}}"></i>
            <span>{{this.label}}: <strong>{{this.total}}</strong></span>
          </span>
          {{/each}}
        </div>

        {{#if bestDieLabel}}
        <span class="badge bg-dark text-secondary border border-secondary border-opacity-25">
          {{bestDieLabel}}
        </span>
        {{/if}}
      </div>
    </div>
    {{/if}}

    <!-- Modificadores de Regra (Auto-detectados da Ficha + Rápidos + Botão de Modal) -->
    {{#if modifiers}}
    <div class="mb-2">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <div class="text-secondary small fw-semibold">
          <i class="fa-solid fa-sliders me-1"></i> {{#if modLabel}}{{modLabel}}{{else}}{{localize "SWAG.Card.RuleModifiersLabel"}}{{/if}}
        </div>
      </div>
      <div class="d-flex flex-wrap gap-1 align-items-center swag-mod-pills-container">
        {{#each modifiers}}
        <button
          type="button"
          class="mod-pill-btn {{this.activeClass}}"
          data-mod-id="{{this.id}}"
          data-mod-value="{{this.value}}"
          data-mod-target="{{../cardId}}"
          title="{{this.title}}"
        >
          {{this.label}}
        </button>
        {{/each}}
        <button
          type="button"
          class="mod-pill-btn mod-pill-add-btn"
          data-swag-action="open-modifiers-modal"
          data-card-id="{{cardId}}"
          title="{{localize 'SWAG.Card.AddModifiersTooltip'}}"
        >
          <i class="fa-solid fa-plus me-1"></i> {{localize "SWAG.Card.AddModifiersBtn"}}
        </button>
      </div>
    </div>
    {{/if}}

    <!-- Descrição ou Texto Rico (para Vantagens, Complicações, Itens, Ancestralidade) -->
    {{#if description}}
    <div class="swag-card-description small text-light mb-2">
      {{{description}}}
    </div>
    {{/if}}

    <!-- Botões de Ação Embutidos de Item (Ex: Adaga das Sombras -> Rolar Característica / Rolar Dano) -->
    {{#if itemActions}}
    <div class="d-flex flex-wrap gap-1 mb-2">
      {{#each itemActions}}
      <button
        type="button"
        class="btn btn-sm {{this.btnClass}} fw-semibold"
        data-swag-action="{{this.swagAction}}"
        data-item-uuid="{{../itemUuid}}"
        data-item-id="{{../itemId}}"
        data-swade-action="{{this.swadeAction}}"
      >
        <i class="{{this.icon}} me-1"></i> {{this.label}}
      </button>
      {{/each}}
    </div>
    {{/if}}

    <!-- Tags de Efeito / Lore / Chips de Item com Tooltips -->
    {{#if tags}}
    <div class="d-flex gap-1 flex-wrap mb-2">
      {{#each tags}}
      <span class="lore-tag" {{#if this.tooltip}}data-tooltip="{{this.tooltip}}" title="{{this.tooltip}}"{{/if}}>
        {{#if this.icon}}<i class="{{this.icon}} me-1 {{this.iconColor}}"></i>{{/if}}
        {{{this.text}}}
      </span>
      {{/each}}
    </div>
    {{/if}}

    <!-- Badge de Status do Item (exibido apenas quando não for Vantagem, Habilidade ou Raça) -->
    {{#unless resultBox}}
    {{#unless isEdge}}
    {{#unless isLore}}
    {{#if statusBadge}}
    <div class="mb-2">
      <span class="badge {{statusBadge.class}} px-2 py-1" style="font-size: 0.72rem;">
        {{#if statusBadge.icon}}<i class="{{statusBadge.icon}} me-1"></i>{{/if}}
        {{statusBadge.text}}
      </span>
    </div>
    {{/if}}
    {{/unless}}
    {{/unless}}
    {{/unless}}

    <!-- Lista de Habilidades / Características (Ex: Sauriano) -->
    {{#if traitList}}
    <div class="d-flex flex-column gap-1 small mb-2">
      {{#each traitList}}
      <div class="p-1 px-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-10">
        <strong class="{{this.colorClass}}">&bull; {{this.name}}:</strong> {{{this.desc}}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- Alerta de Complicação / Gatilho de Bene -->
    {{#if hindranceTrigger}}
    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 small py-1 px-2 mb-2">
      <i class="fa-solid fa-award me-1"></i>
      <strong>{{localize "SWAG.Card.BennyTriggerTitle"}}</strong> {{{hindranceTrigger}}}
    </div>
    {{/if}}

    <!-- Resultado da Rolagem (Empilhado e ocupando 100% da largura do box) -->
    {{#if resultBox}}
    {{#if statusBadge}}
    <div class="swag-outcome-banner swag-stacked-box mb-2 mt-2">
      <div class="stat-label mb-1">{{#if isDamage}}{{localize "SWAG.Card.DamageEffectHeader"}}{{else}}{{localize "SWAG.Card.RollOutcomeHeader"}}{{/if}}</div>
      <div class="badge swag-outcome-badge swag-fullwidth-badge {{statusBadge.class}}">
        {{#if statusBadge.icon}}<i class="{{statusBadge.icon}} me-1"></i>{{/if}}
        <span>{{statusBadge.text}}</span>
      </div>
    </div>
    {{/if}}

    <!-- Box de Explosão de Dados (Ás no Dado da Característica e/ou Dado Selvagem) -->
    {{#if aceDetails}}
    <div class="swag-ace-banner swag-stacked-box mb-2">
      <div class="stat-label mb-1">
        <i class="fa-solid fa-bolt text-success me-1"></i> {{localize "SWAG.Card.AceBreakdownHeader"}}
      </div>
      <div class="d-flex flex-column gap-1 w-100">
        {{#each aceDetails}}
        <div class="badge swag-ace-detail-badge swag-fullwidth-badge {{this.badgeClass}}">
          <i class="{{this.icon}} me-1"></i>
          <span><strong>{{this.dieLabel}}</strong> &mdash; {{this.aceCountText}} <code>[{{this.rollsText}}]</code> = <strong>{{this.total}}</strong></span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Caixa de Resultado Numérico de Alto Impacto (Score Box) -->
    <div class="result-score-box d-flex justify-content-between align-items-center gap-2" style="{{#if resultBox.borderColor}}border-color: {{resultBox.borderColor}} !important;{{/if}}">
      <div class="min-w-0 flex-grow-1">
        <div class="stat-label" style="{{#if resultBox.labelColor}}color: {{resultBox.labelColor}};{{/if}}">{{resultBox.title}}</div>
        <div class="small text-light swag-result-description">{{{resultBox.description}}}</div>
      </div>
      <div class="text-end flex-shrink-0">
        <div class="result-score-number {{resultBox.scoreClass}}" id="{{cardId}}-total" style="{{#if resultBox.scoreColor}}color: {{resultBox.scoreColor}};{{/if}}">
          {{resultBox.total}}
        </div>
      </div>
    </div>
    {{/if}}
  </div>

  <!-- 3. RODAPÉ DO CARD (Footer com Ações) -->
  <div class="swag-card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
    <!-- Lado Esquerdo do Rodapé -->
    <div class="d-flex align-items-center gap-1 flex-wrap">
      {{#if footerSource}}
      <small class="text-secondary">
        {{#if footerSource.icon}}<i class="{{footerSource.icon}} me-1"></i>{{/if}}
        {{footerSource.text}}
      </small>
      {{/if}}

      {{#if footerTarget}}
      <span class="text-secondary small">
        <i class="fa-solid fa-shield text-info me-1"></i> {{localize "SWAG.Combat.Target"}}: <strong>{{footerTarget}}</strong>
      </span>
      {{/if}}

      {{#if showBennyBtn}}
      <button type="button" class="btn btn-sm btn-bennie" data-swag-action="spend-benny" data-actor-id="{{actorId}}" data-card-id="{{cardId}}">
        <i class="fa-solid fa-coins me-1"></i> {{localize "SWAG.Card.BennyBtn"}}
      </button>
      {{/if}}

      {{#if showRerollBtn}}
      <button type="button" class="btn btn-sm btn-outline-secondary text-light py-0 px-2" data-swag-action="reroll-card" data-card-id="{{cardId}}">
        <i class="fa-solid fa-rotate-right me-1"></i> {{localize "SWAG.Card.RerollBtn"}}
      </button>
      {{/if}}

      {{#if showPPBtn}}
      <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2" data-swag-action="spend-pp" data-pp-cost="{{ppCost}}" data-actor-id="{{actorId}}">
        <i class="fa-solid fa-bolt me-1"></i> -{{ppCost}} PP
      </button>
      {{/if}}

      {{#if grantBennyReason}}
      <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 fw-semibold" data-swag-action="grant-benny" data-actor-id="{{actorId}}" data-reason="{{grantBennyReason}}">
        <i class="fa-solid fa-coins me-1"></i> {{localize "SWAG.Card.GrantBennyBtn"}}
      </button>
      {{/if}}
    </div>

    <!-- Lado Direito do Rodapé (Ações Primárias) -->
    <div class="d-flex gap-1 flex-wrap align-items-center">
      {{#if showRollDamageBtn}}
      <button type="button" class="btn btn-sm btn-warning text-dark fw-bold" data-swag-action="roll-damage" data-item-id="{{itemId}}" data-item-uuid="{{itemUuid}}">
        <i class="fa-solid fa-burst me-1"></i> {{localize "SWAG.Roll.RollDamage"}}
      </button>
      {{/if}}

      {{#if showApplyDamageBtn}}
      <button type="button" class="btn btn-sm btn-danger fw-bold" data-swag-action="apply-damage" data-damage="{{resultBox.total}}" data-wounds="{{calculatedWounds}}">
        <i class="fa-solid fa-skull me-1"></i> {{localize "SWAG.Combat.Wounds"}} ({{calculatedWounds}})
      </button>
      {{/if}}

      {{#if showKnockbackBtn}}
      <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 fw-semibold" data-swag-action="roll-knockback" data-damage="{{resultBox.total}}">
        <i class="fa-solid fa-person-falling-burst me-1"></i> Projeção
      </button>
      {{/if}}

      {{#if showPowerStuntBtn}}
      <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 fw-semibold" data-swag-action="power-stunt" data-actor-id="{{actorId}}">
        <i class="fa-solid fa-mask me-1"></i> {{localize "SPC.PowerStunt.Label"}}
      </button>
      {{/if}}

      {{#if showItemUseBtn}}
      <button type="button" class="btn btn-sm btn-outline-info py-0 px-2 fw-semibold" data-swag-action="use-item" data-item-id="{{itemId}}" data-item-uuid="{{itemUuid}}">
        <i class="{{#if itemActionIcon}}{{itemActionIcon}}{{else}}fa-solid fa-hand-sparkles{{/if}} me-1"></i> {{itemActionLabel}}
      </button>
      {{/if}}

      {{#if showCompendiumBtn}}
      <button type="button" class="btn btn-sm btn-outline-light border-secondary border-opacity-25 py-0 px-2 fw-semibold" data-swag-action="open-compendium" data-uuid="{{compendiumUuid}}">
        <i class="fa-solid fa-eye me-1"></i> Ficha
      </button>
      {{/if}}

      {{#if showImportActorBtn}}
      <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" data-swag-action="import-archetype" data-uuid="{{compendiumUuid}}">
        <i class="fa-solid fa-file-import me-1"></i> Importar Ator
      </button>
      {{/if}}

      {{#if showMacroBtn}}
      <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" data-swag-action="save-macro" data-macro-name="{{title}}" data-macro-formula="{{macroFormula}}">
        <i class="fa-solid fa-code me-1"></i> {{localize "SWAG.Card.MacroBtn"}}
      </button>
      {{/if}}
    </div>
  </div>
</div>
